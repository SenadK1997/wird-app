{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "test-ads": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_TEST_ADS": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
